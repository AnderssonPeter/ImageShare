{
  "sdk": {
    "version": "10.0.301",
    "rollForward": "latestFeature"
  },
  "scriptShell": "pwsh",
  "scripts": {
    "format": "dotnet format ImageShare.slnx",
    "format:check": "dotnet format ImageShare.slnx --verify-no-changes",
    "test": "dotnet run --project ImageShare.Tests/ImageShare.Tests.csproj",
    "build": "dotnet build",
    "startup": "pwsh ./scripts/startup.ps1",
    "ci": "dotnet build-server shutdown && dotnet r format:check && dotnet r build && dotnet r test && dotnet r startup"
  }
}
