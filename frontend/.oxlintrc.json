{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "eslint",
    "react-perf",
    "typescript",
    "oxc",
    "unicorn",
    "import",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn",
    "pedantic": "warn",
    "style": "warn",
    "nursery": "off"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/jsx-key": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/jsx-no-target-blank": "error",
    "react/jsx-no-undef": "error",
    "react/no-children-prop": "error",
    "react/no-danger": "warn",
    "react/react-in-jsx-scope": "off",
    "react/jsx-filename-extension": ["warn", { "extensions": [".tsx", ".jsx"] }],
    "react/jsx-props-no-spreading": "off",
    "react/jsx-no-constructed-context-values": "off",
    "unicorn/filename-case": [
      "warn",
      { "cases": { "camelCase": true, "pascalCase": false, "kebabCase": false } }
    ],
    "react/no-direct-mutation-state": "error",
    "react/no-unknown-property": "warn",
    "typescript/no-unused-vars": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-deprecated": "warn",
    "import/exports-last": "off",
    "import/consistent-type-specifier-style": ["warn", "prefer-inline"],
    "eslint/sort-imports": "warn",
    "eslint/no-ternary": "off",
    "eslint/sort-keys": "off",
    "eslint/func-style": ["warn", "declaration"],
    "eslint/no-magic-numbers": "off",
    "eslint/no-underscore-dangle": ["warn", { "allow": ["_splat"] }],
    "eslint/max-lines-per-function": ["warn", 50],
    "unicorn/no-array-for-each": "warn",
    "vitest/prefer-called-once": "off",
    "vitest/prefer-to-be-truthy": "off",
    "vitest/prefer-to-be-falsy": "off",
    "react-perf/jsx-no-new-object-as-prop": "warn",
    "react-perf/jsx-no-jsx-as-prop": "warn",
    "import/group-exports": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^\\.{1,2}/",
            "message": "Relative imports are not allowed — use a @ path alias instead (e.g. @lib/utils)."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["vite.config.ts"],
      "rules": {
        "eslint/no-inline-comments": "off"
      }
    },
    {
      "files": ["**/*.test.{ts,tsx}", "**/*.spec.{ts,tsx}", "src/test/**"],
      "rules": {
        "react/no-danger": "off",
        "vitest/no-importing-vitest-globals": "off",
        "vitest/prefer-importing-vitest-globals": "error",
        "vitest/require-test-timeout": "error",
        "vitest/prefer-import-in-mock": "warn"
      }
    },
    {
      "files": ["src/test/setup.ts"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": ["src/main.tsx"],
      "rules": {
        "import/no-unassigned-import": "off",
        "vitest/require-hook": "off"
      }
    },
    {
      "files": ["src/routes/**"],
      "rules": {
        "import/no-named-export": "off",
        "import/prefer-default-export": "off"
      }
    },
    {
      "files": ["src/components/**"],
      "rules": {
        "unicorn/filename-case": [
          "warn",
          { "cases": { "camelCase": false, "pascalCase": true, "kebabCase": false } }
        ]
      }
    },
    {
      "files": ["src/lib/**", "src/router.tsx"],
      "rules": {
        "import/no-named-export": "off",
        "import/prefer-default-export": "off"
      }
    },
    {
      "files": [
        "vite.config.ts",
        "vitest.config.ts",
        "orval.config.ts",
        "*.config.{ts,mts,js,mjs}"
      ],
      "rules": {
        "import/no-nodejs-modules": "off",
        "import/no-unassigned-import": "off",
        "sort-imports": "off"
      }
    },
    {
      "files": ["src/lib/api/generated/**", "src/routeTree.gen.ts"],
      "rules": {
        "unicorn/filename-case": "off",
        "unicorn/no-abusive-eslint-disable": "off",
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/main.tsx", "src/router.tsx"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
