{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{ClientIP}] [{UserName}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": []
  },
  "AllowedHosts": "*",
  "OpenIdConnect": {
    "Authority": "https://your-pocket-id-domain",
    "ClientId": "",
    "ClientSecret": "",
    "ResponseType": "code",
    "GetClaimsFromUserInfoEndpoint": true,
    "AdminRole": "admin"
  },
  "ApiKeys": {
  },
  "Jwt": {
    "Issuer": "ImageShare",
    "Audience": "ImageShare",
    "SigningKey": ""
  },
  "RateLimit": {
    "PermitLimit": 10,
    "WindowSeconds": 60
  },
  "ImageFormats": {
    "SupportedFormats": ["avif", "webp", "jpg"]
  },
  "ImageConversion": {
    "FullQuality": 95,
    "ThumbnailQuality": 80,
    "ThumbnailMaxWidth": 200,
    "ThumbnailMaxHeight": 200
  },
  "UsageAgreement": {
    "Agreements": []
  }
}
