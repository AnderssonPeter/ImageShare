{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft": "Warning",
      "System": "Warning"
    },
    "Console": {
      "FormatterName": "ImageShare"
    }
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": []
  },
  "AllowedHosts": "*",
  "DataProtection": {
    "KeyStoragePath": ""
  },
  "OpenIdConnect": {
    "Authority": "",
    "ClientId": "",
    "ClientSecret": "",
    "ResponseType": "code",
    "GetClaimsFromUserInfoEndpoint": true,
    "AdminRole": "admin"
  },
  "ApiKeys": {
  },
  "Jwt": {
    "Issuer": "ImageShare",
    "Audience": "ImageShare",
    "SigningKey": ""
  },
  "RateLimit": {
    "PermitLimit": 10,
    "WindowSeconds": 60
  },
  "ImageFormats": {
    "SupportedFormats": ["avif", "webp", "jpg"]
  },
  "ImageConversion": {
    "FullQuality": 95,
    "ThumbnailQuality": 80,
    "ThumbnailMaxWidth": 200,
    "ThumbnailMaxHeight": 200
  },
  "UsageAgreement": {
    "Agreements": []
  }
}
